{
  "name": "klankstroom",
  "productName": "Klankstroom",
  "version": "1.0.0",
  "description": "Muziekspeler voor pc en Android: radio, legale gratis muziek, gekoppelde accounts, lokale muziek en een 3D-visualizer.",
  "author": "Endless (Joris Zuijdervliet)",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "npx http-server www -p 8080 -c-1",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "android:add": "cap add android && node scripts/patch-android.js && cap sync android",
    "android:sync": "node scripts/patch-android.js && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "nl.endless.klankstroom",
    "productName": "Klankstroom",
    "files": ["electron/**", "www/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "www/icons/icon-512.png" },
    "linux": { "target": ["AppImage"], "icon": "www/icons/icon-512.png", "category": "Audio" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Klankstroom", "artifactName": "Klankstroom-Setup.exe" },
    "portable": { "artifactName": "Klankstroom-portable.exe" }
  }
}
